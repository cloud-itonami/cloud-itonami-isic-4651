;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": an AS/RS / goods-to-person robotic shuttle
;; picks and stages ESD-safe computer-hardware cartons at the wholesale
;; distribution centre for dispatch (ISIC 4651). The physical work: an arm
;; lifting server and peripheral cartons onto the staging pallet, and an AGV
;; carrying the stacked pallet of servers.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-4651"
 :cases
 [{:id :stage-server-carton
   :kind :manipulator
   :procedure "staging arm lifts a server or peripheral carton from the goods-to-person port onto the outbound pallet"
   :params {:l1-m 0.70 :l2-m 0.60 :m1-kg 12.0 :m2-kg 7.0
            :from [0.85 0.05] :to [0.40 0.90] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [2.0 5.0 10.0 20.0 30.0]}
   :quantity :peak-tau1-nm
   :limit {:max 220.0 :basis "estimate: continuous shoulder torque of a ~15 kg-payload arm with a 1.3 m reach"}
   :boundary {:lo 0.5 :hi 80.0}}
  {:id :server-pallet-agv-stop
   :kind :transport
   :procedure "AGV carries a 400 kg pallet of stacked server cartons to the dock and makes an emergency stop at 2 m/s2; the stack height sets the load's centre of gravity"
   :params {:mass-kg 600.0 :payload-kg 400.0 :distance-m 60.0 :v-max-mps 1.5 :a-max-mps2 0.5
            :brake-decel-mps2 2.0 :drive-force-n 1500.0 :crr 0.015 :cog-height-m 0.35
            :support-half-length-m 0.50 :max-time-s 1200.0}
   :sweep {:param :payload-cog-height-m :values [0.6 0.9 1.2 1.5 1.8]}
   :quantity :min-tipover-margin
   :limit {:min 0.7 :basis "estimate: stability reserve kept for fragile, shrink-wrapped hardware stacks that must not shift in an emergency stop"}
   :boundary {:lo 0.3 :hi 3.0}}]}
